{{ form_start(form) }}

    <div>
        {{ form_errors(form) }}
    </div>

    <div>
        {{ form_label(form.title,'Please enter the title') }}
    </div>

    <div>
        {{ form_widget(form.title,{'attr': {'style':'color:gray'}}) }}
    </div>

    <div>
        {{ form_label(form.text, 'Please enter the text') }}
    </div>



    <div>
        {{ form_widget(form.text) }}
    </div>

    <div>
        <button type="submit">Create Post</button>
    </div>

{{ form_end(form) }}